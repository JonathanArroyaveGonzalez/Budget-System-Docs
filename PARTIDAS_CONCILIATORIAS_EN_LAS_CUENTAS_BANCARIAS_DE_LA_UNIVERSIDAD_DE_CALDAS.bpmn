<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  
  <!-- Proceso Principal -->
  <process id="ProcesoConciliacionBancaria" name="Proceso de Conciliación Bancaria - Consignaciones por Identificar" isExecutable="true">
    
    <!-- Lanes (Actores) -->
    <laneSet id="LaneSet_1">
      <lane id="Lane_Tesoreria" name="Tesorería">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Activity_IdentificarPartidas</flowNodeRef>
        <flowNodeRef>Activity_RegistroTransitorio</flowNodeRef>
      </lane>
      
      <lane id="Lane_UnidadesEjecutoras" name="Unidades Ejecutoras">
        <flowNodeRef>Activity_AnalizarSoportes</flowNodeRef>
        <flowNodeRef>Activity_ContinuarAnalisis</flowNodeRef>
      </lane>
      
      <lane id="Lane_OficinaFinanciera" name="Oficina Financiera">
        <flowNodeRef>Gateway_Identificado</flowNodeRef>
        <flowNodeRef>Activity_AjustesContables</flowNodeRef>
        <flowNodeRef>Event_Timer_4Meses</flowNodeRef>
        <flowNodeRef>Activity_Reclasificacion</flowNodeRef>
        <flowNodeRef>Activity_ReconocimientoPresupuestal</flowNodeRef>
      </lane>
      
      <lane id="Lane_General" name="General">
        <flowNodeRef>Activity_AsegurarConciliacion</flowNodeRef>
        <flowNodeRef>EndEvent_1</flowNodeRef>
      </lane>
    </laneSet>
    
    <!-- Evento de Inicio: Cierre Mensual -->
    <startEvent id="StartEvent_1" name="Cierre Mensual">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    
    <!-- Actividad: Identificar partidas pendientes -->
    <task id="Activity_IdentificarPartidas" name="Identificar partidas pendientes&#10;(consignaciones por identificar)">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </task>
    
    <!-- Actividad: Realizar registro transitorio -->
    <task id="Activity_RegistroTransitorio" name="Realizar registro transitorio&#10;(Comp. 922-250)&#10;Débito: Banco&#10;Crédito: 24072001">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
    </task>
    
    <!-- Actividad: Analizar y buscar soportes -->
    <task id="Activity_AnalizarSoportes" name="Analizar y buscar soportes&#10;de los depósitos recibidos">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
    </task>
    
    <!-- Compuerta de Decisión: ¿Se identificó el depósito? -->
    <exclusiveGateway id="Gateway_Identificado" name="¿Se identificó&#10;el depósito?" gatewayDirection="Diverging">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_SI</outgoing>
      <outgoing>Flow_NO</outgoing>
    </exclusiveGateway>
    
    <!-- Flujo SÍ: Realizar ajustes contables -->
    <task id="Activity_AjustesContables" name="Realizar ajustes contables&#10;y presupuestales&#10;(abono a facturas o&#10;ingreso a proyecto)">
      <incoming>Flow_SI</incoming>
      <outgoing>Flow_FinAjustes</outgoing>
    </task>
    
    <!-- Flujo NO: Temporizador 4 meses -->
    <intermediateCatchEvent id="Event_Timer_4Meses" name="Esperar 4 meses&#10;(Marzo, Julio o Noviembre)">
      <incoming>Flow_NO</incoming>
      <outgoing>Flow_5</outgoing>
      <timerEventDefinition>
        <timeCycle>R0/2024-03-01T00:00:00Z/P4M</timeCycle>
      </timerEventDefinition>
    </intermediateCatchEvent>
    
    <!-- Actividad: Reclasificación periódica -->
    <task id="Activity_Reclasificacion" name="Reclasificar valor contablemente&#10;• Servicios académicos → 4305&#10;• Otros recaudos → 48082601">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
    </task>
    
    <!-- Actividad: Reconocimiento presupuestal -->
    <task id="Activity_ReconocimientoPresupuestal" name="Reconocer presupuestalmente&#10;como recursos de capital&#10;(recuperaciones o reintegros)">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
    </task>
    
    <!-- Unión de flujos después de ajustes o reclasificación -->
    <exclusiveGateway id="Gateway_Join" gatewayDirection="Converging">
      <incoming>Flow_FinAjustes</incoming>
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
    </exclusiveGateway>
    
    <!-- Actividad: Asegurar conciliación -->
    <task id="Activity_AsegurarConciliacion" name="Asegurar que no existan diferencias&#10;entre saldo en libros y&#10;extracto bancario&#10;(31 de diciembre)">
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
    </task>
    
    <!-- Actividad: Continuar análisis (Unidades Ejecutoras) -->
    <task id="Activity_ContinuarAnalisis" name="Continuar análisis y envío&#10;de soportes para ajustes&#10;finales de cartera">
      <incoming>Flow_9</incoming>
      <outgoing>Flow_10</outgoing>
    </task>
    
    <!-- Evento de Fin -->
    <endEvent id="EndEvent_1" name="Saldos integrados fielmente&#10;en estados financieros">
      <incoming>Flow_10</incoming>
    </endEvent>
    
    <!-- Secuencias de Flujo -->
    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_IdentificarPartidas"/>
    <sequenceFlow id="Flow_2" sourceRef="Activity_IdentificarPartidas" targetRef="Activity_RegistroTransitorio"/>
    <sequenceFlow id="Flow_3" sourceRef="Activity_RegistroTransitorio" targetRef="Activity_AnalizarSoportes"/>
    <sequenceFlow id="Flow_4" sourceRef="Activity_AnalizarSoportes" targetRef="Gateway_Identificado"/>
    
    <sequenceFlow id="Flow_SI" name="SÍ" sourceRef="Gateway_Identificado" targetRef="Activity_AjustesContables"/>
    <sequenceFlow id="Flow_NO" name="NO" sourceRef="Gateway_Identificado" targetRef="Event_Timer_4Meses"/>
    
    <sequenceFlow id="Flow_FinAjustes" sourceRef="Activity_AjustesContables" targetRef="Gateway_Join"/>
    <sequenceFlow id="Flow_5" sourceRef="Event_Timer_4Meses" targetRef="Activity_Reclasificacion"/>
    <sequenceFlow id="Flow_6" sourceRef="Activity_Reclasificacion" targetRef="Activity_ReconocimientoPresupuestal"/>
    <sequenceFlow id="Flow_7" sourceRef="Activity_ReconocimientoPresupuestal" targetRef="Gateway_Join"/>
    
    <sequenceFlow id="Flow_8" sourceRef="Gateway_Join" targetRef="Activity_AsegurarConciliacion"/>
    <sequenceFlow id="Flow_9" sourceRef="Activity_AsegurarConciliacion" targetRef="Activity_ContinuarAnalisis"/>
    <sequenceFlow id="Flow_10" sourceRef="Activity_ContinuarAnalisis" targetRef="EndEvent_1"/>
    
  </process>
  
  <!-- Diagrama de la notación -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1" name="Diagrama Conciliación Bancaria">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ProcesoConciliacionBancaria">
      
      <!-- Lanes -->
      <bpmndi:BPMNShape id="Lane_Tesoreria_di" bpmnElement="Lane_Tesoreria" isHorizontal="true">
        <omgdc:Bounds x="160" y="80" width="1000" height="120"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Lane_UnidadesEjecutoras_di" bpmnElement="Lane_UnidadesEjecutoras" isHorizontal="true">
        <omgdc:Bounds x="160" y="200" width="1000" height="120"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Lane_OficinaFinanciera_di" bpmnElement="Lane_OficinaFinanciera" isHorizontal="true">
        <omgdc:Bounds x="160" y="320" width="1000" height="200"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Lane_General_di" bpmnElement="Lane_General" isHorizontal="true">
        <omgdc:Bounds x="160" y="520" width="1000" height="120"/>
      </bpmndi:BPMNShape>
      
      <!-- Elementos en Tesorería -->
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="192" y="110" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="182" y="153" width="70" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Activity_IdentificarPartidas_di" bpmnElement="Activity_IdentificarPartidas">
        <omgdc:Bounds x="280" y="88" width="140" height="80"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Activity_RegistroTransitorio_di" bpmnElement="Activity_RegistroTransitorio">
        <omgdc:Bounds x="480" y="88" width="160" height="80"/>
      </bpmndi:BPMNShape>
      
      <!-- Elementos en Unidades Ejecutoras -->
      <bpmndi:BPMNShape id="Activity_AnalizarSoportes_di" bpmnElement="Activity_AnalizarSoportes">
        <omgdc:Bounds x="700" y="208" width="140" height="80"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Activity_ContinuarAnalisis_di" bpmnElement="Activity_ContinuarAnalisis">
        <omgdc:Bounds x="880" y="540" width="140" height="80"/>
      </bpmndi:BPMNShape>
      
      <!-- Elementos en Oficina Financiera -->
      <bpmndi:BPMNShape id="Gateway_Identificado_di" bpmnElement="Gateway_Identificado" isMarkerVisible="true">
        <omgdc:Bounds x="905" y="223" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="895" y="280" width="70" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Activity_AjustesContables_di" bpmnElement="Activity_AjustesContables">
        <omgdc:Bounds x="1000" y="208" width="140" height="80"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Event_Timer_4Meses_di" bpmnElement="Event_Timer_4Meses">
        <omgdc:Bounds x="912" y="360" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="890" y="403" width="80" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Activity_Reclasificacion_di" bpmnElement="Activity_Reclasificacion">
        <omgdc:Bounds x="700" y="338" width="160" height="80"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Activity_ReconocimientoPresupuestal_di" bpmnElement="Activity_ReconocimientoPresupuestal">
        <omgdc:Bounds x="480" y="338" width="160" height="80"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Gateway_Join_di" bpmnElement="Gateway_Join" isMarkerVisible="true">
        <omgdc:Bounds x="345" y="353" width="50" height="50"/>
      </bpmndi:BPMNShape>
      
      <!-- Elementos en General -->
      <bpmndi:BPMNShape id="Activity_AsegurarConciliacion_di" bpmnElement="Activity_AsegurarConciliacion">
        <omgdc:Bounds x="480" y="540" width="160" height="80"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <omgdc:Bounds x="1092" y="562" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="1072" y="605" width="90" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <!-- Flujos de secuencia -->
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="228" y="128"/>
        <omgdi:waypoint x="280" y="128"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="420" y="128"/>
        <omgdi:waypoint x="480" y="128"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <omgdi:waypoint x="640" y="128"/>
        <omgdi:waypoint x="770" y="128"/>
        <omgdi:waypoint x="770" y="208"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <omgdi:waypoint x="840" y="248"/>
        <omgdi:waypoint x="905" y="248"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_SI_di" bpmnElement="Flow_SI">
        <omgdi:waypoint x="955" y="248"/>
        <omgdi:waypoint x="1000" y="248"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="970" y="230" width="20" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_NO_di" bpmnElement="Flow_NO">
        <omgdi:waypoint x="930" y="273"/>
        <omgdi:waypoint x="930" y="360"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="935" y="310" width="20" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_FinAjustes_di" bpmnElement="Flow_FinAjustes">
        <omgdi:waypoint x="1070" y="248"/>
        <omgdi:waypoint x="1100" y="248"/>
        <omgdi:waypoint x="1100" y="580"/>
        <omgdi:waypoint x="1092" y="580"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <omgdi:waypoint x="912" y="378"/>
        <omgdi:waypoint x="860" y="378"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <omgdi:waypoint x="700" y="378"/>
        <omgdi:waypoint x="640" y="378"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <omgdi:waypoint x="480" y="378"/>
        <omgdi:waypoint x="395" y="378"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <omgdi:waypoint x="370" y="403"/>
        <omgdi:waypoint x="370" y="580"/>
        <omgdi:waypoint x="480" y="580"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <omgdi:waypoint x="640" y="580"/>
        <omgdi:waypoint x="880" y="580"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <omgdi:waypoint x="1020" y="580"/>
        <omgdi:waypoint x="1092" y="580"/>
      </bpmndi:BPMNEdge>
      
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  
</definitions>