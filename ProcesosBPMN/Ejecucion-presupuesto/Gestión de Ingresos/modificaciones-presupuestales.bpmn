      <bpmndi:BPMNShape id="Activity_0cfai20_di" bpmnElement="Task_3" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="710" y="265" width="100" height="80" />
