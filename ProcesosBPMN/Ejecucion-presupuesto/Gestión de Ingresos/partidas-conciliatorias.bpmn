<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.1">
  <collaboration id="Collaboration_0zjzq6d">
    <participant id="Participant_1yu6dnt" name="Proceso de Conciliación Bancaria - Consignaciones por Identificar" processRef="ProcesoConciliacionBancaria" />
  </collaboration>
  <process id="ProcesoConciliacionBancaria" name="Proceso de Conciliación Bancaria - Consignaciones por Identificar" isExecutable="true">
    <laneSet id="LaneSet_1">
      <lane id="Lane_General" name="General">
        <flowNodeRef>EndEvent_1</flowNodeRef>
        <flowNodeRef>Activity_AsegurarConciliacion</flowNodeRef>
        <flowNodeRef>Activity_ContinuarAnalisis</flowNodeRef>
      </lane>
      <lane id="Lane_OficinaFinanciera" name="Oficina Financiera">
        <flowNodeRef>Event_Timer_4Meses</flowNodeRef>
        <flowNodeRef>Activity_Reclasificacion</flowNodeRef>
        <flowNodeRef>Activity_ReconocimientoPresupuestal</flowNodeRef>
      </lane>
      <lane id="Lane_UnidadesEjecutoras" name="Unidades Ejecutoras">
        <flowNodeRef>Gateway_Identificado</flowNodeRef>
        <flowNodeRef>Activity_AnalizarSoportes</flowNodeRef>
        <flowNodeRef>Activity_AjustesContables</flowNodeRef>
      </lane>
      <lane id="Lane_Tesoreria" name="Tesorería">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Activity_IdentificarPartidas</flowNodeRef>
        <flowNodeRef>Activity_RegistroTransitorio</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartEvent_1" name="Cierre Mensual">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <exclusiveGateway id="Gateway_Identificado" name="¿Se identificó&#10;el depósito?" gatewayDirection="Diverging">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_SI</outgoing>
      <outgoing>Flow_NO</outgoing>
    </exclusiveGateway>
    <endEvent id="EndEvent_1" name="Saldos integrados fielmente en estados financieros">
      <incoming>Flow_10</incoming>
      <incoming>Flow_FinAjustes</incoming>
    </endEvent>
    <intermediateCatchEvent id="Event_Timer_4Meses" name="Esperar 4 meses&#10;(Marzo, Julio o Noviembre)">
      <incoming>Flow_NO</incoming>
      <outgoing>Flow_5</outgoing>
      <timerEventDefinition>
        <timeCycle>R0/2024-03-01T00:00:00Z/P4M</timeCycle>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_IdentificarPartidas" />
    <sequenceFlow id="Flow_2" sourceRef="Activity_IdentificarPartidas" targetRef="Activity_RegistroTransitorio" />
    <sequenceFlow id="Flow_3" sourceRef="Activity_RegistroTransitorio" targetRef="Activity_AnalizarSoportes" />
    <sequenceFlow id="Flow_7" sourceRef="Activity_ReconocimientoPresupuestal" targetRef="Activity_AsegurarConciliacion" />
    <sequenceFlow id="Flow_6" sourceRef="Activity_Reclasificacion" targetRef="Activity_ReconocimientoPresupuestal" />
    <sequenceFlow id="Flow_5" sourceRef="Event_Timer_4Meses" targetRef="Activity_Reclasificacion" />
    <sequenceFlow id="Flow_9" sourceRef="Activity_AsegurarConciliacion" targetRef="Activity_ContinuarAnalisis" />
    <sequenceFlow id="Flow_10" sourceRef="Activity_ContinuarAnalisis" targetRef="EndEvent_1" />
    <sequenceFlow id="Flow_4" sourceRef="Activity_AnalizarSoportes" targetRef="Gateway_Identificado" />
    <sequenceFlow id="Flow_SI" name="SÍ" sourceRef="Gateway_Identificado" targetRef="Activity_AjustesContables" />
    <sequenceFlow id="Flow_NO" name="NO" sourceRef="Gateway_Identificado" targetRef="Event_Timer_4Meses" />
    <sequenceFlow id="Flow_FinAjustes" sourceRef="Activity_AjustesContables" targetRef="EndEvent_1" />
    <userTask id="Activity_IdentificarPartidas" name="Identificar partidas pendientes&#10;(consignaciones por identificar)">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </userTask>
    <userTask id="Activity_RegistroTransitorio" name="Realizar registro transitorio">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
    </userTask>
    <userTask id="Activity_AnalizarSoportes" name="Analizar y buscar soportes&#10;de los depósitos recibidos">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
    </userTask>
    <businessRuleTask id="Activity_AjustesContables" name="Realizar ajustes contables&#10;y presupuestales">
      <incoming>Flow_SI</incoming>
      <outgoing>Flow_FinAjustes</outgoing>
    </businessRuleTask>
    <businessRuleTask id="Activity_Reclasificacion" name="Reclasificar valor contablemente">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
    </businessRuleTask>
    <businessRuleTask id="Activity_ReconocimientoPresupuestal" name="Reconocer presupuestalmente&#10;como recursos de capital">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
    </businessRuleTask>
    <userTask id="Activity_AsegurarConciliacion" name="No hay diferencias&#10;entre saldo en libros y&#10;extracto">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_9</outgoing>
    </userTask>
    <userTask id="Activity_ContinuarAnalisis" name="Continuar análisis y envío&#10;de soportes para ajustes&#10;finales de cartera">
      <incoming>Flow_9</incoming>
      <outgoing>Flow_10</outgoing>
    </userTask>
  </process>
