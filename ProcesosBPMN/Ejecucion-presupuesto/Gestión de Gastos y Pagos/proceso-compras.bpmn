      <incoming>Flow_15</incoming>
      <outgoing>Flow_16</outgoing>
    </serviceTask>
    <endEvent id="End_1" name="Contrato en ejecución">
      <incoming>Flow_Fin</incoming>
    </endEvent>
    <exclusiveGateway id="Gateway_EjecucionOK" name="¿Documentación sin errores?">
      <incoming>Flow_17</incoming>
