  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Expedición de CDP y Reintegro de Saldos - Universidad de Caldas" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_5" name="Profesional Financiera">
        <bpmn:flowNodeRef>Task_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Operario Calificado">
        <bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef>
